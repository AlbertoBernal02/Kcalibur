# Copia este archivo a .env.local y rellena los valores. .env.local NO se sube a git.

# Supabase (Project Settings > API). La clave publicable es pública por diseño: la seguridad la da RLS.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Solo para aplicar migraciones desde tu ordenador (npm run migrate). No hace falta en Vercel.
# Connect > Session pooler. Lleva tu contraseña de base de datos.
SUPABASE_DB_URL=postgresql://postgres.TU-PROYECTO:TU-CONTRASEÑA@aws-1-REGION.pooler.supabase.com:5432/postgres

# Asistente de IA (opcional). Solo servidor: no uses el prefijo NEXT_PUBLIC_ o se expondría.
# Sin clave, la pantalla del asistente avisa de que no está activado.
ANTHROPIC_API_KEY=
# Modelo del asistente (por defecto claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5
