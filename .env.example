# Copia este archivo a .env.local y rellena los valores. .env.local NO se sube a git.

# Supabase (Project Settings > API). La clave publicable es pública por diseño: la seguridad la da RLS.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Solo para aplicar migraciones desde tu ordenador (npm run migrate). No hace falta en Vercel.
# Connect > Session pooler. Lleva tu contraseña de base de datos.
SUPABASE_DB_URL=postgresql://postgres.TU-PROYECTO:TU-CONTRASEÑA@aws-1-REGION.pooler.supabase.com:5432/postgres

# Asistente de IA (opcional). Por defecto usa gpt-oss-120b en Groq, que tiene plan gratuito sin tarjeta:
# crea una clave en https://console.groq.com (API Keys). Solo servidor: no uses el prefijo NEXT_PUBLIC_.
# Sin clave, la pantalla del asistente avisa de que no está activado.
AI_API_KEY=

# --- Opcional: cambiar de proveedor/modelo (cualquier API compatible con OpenAI) ---
# Groq elimina modelos de vez en cuando: si falla con "modelo no disponible", mira el actual en console.groq.com/docs/models
# AI_MODEL=openai/gpt-oss-120b   # alternativa: qwen/qwen3.8-27b (razona mucho y tiene tope de 1.000 tokens de salida por minuto)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_FALLBACK_MODEL=openai/gpt-oss-20b   # modelo de reserva si el principal falla (retirado, limite o caida). off lo desactiva
# AI_REASONING_EFFORT=low         # gpt-oss: low | medium | high. Qwen: none | low | medium | high (por defecto low)
# Ejemplos de otro proveedor:
#   Gemini     AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.5-flash
#   OpenRouter AI_BASE_URL=https://openrouter.ai/api/v1                              AI_MODEL=<modelo>
#   Ollama     AI_BASE_URL=http://localhost:11434/v1                                 AI_MODEL=qwen3:8b   (sin clave, solo en tu PC)
